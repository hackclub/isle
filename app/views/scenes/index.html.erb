<% content_for :head do %>
  <%= vite_javascript_tag "map_viewer" %>
  <%= vite_stylesheet_tag "map_viewer.scss" %>
<% end %>
<div id="app">
  <%= image_tag "/overlay.png", id: "overlay-image", alt: "Overlay" %>
  <div id="hover-display" class="hover-display"></div>
  <div id="map-container">
    <%= image_tag "/map.jpg", id: "map-image", alt: "Map" %>
    <svg id="overlay-svg"></svg>
  </div>
</div>
<script>
  // Pass Rails data to JavaScript
  window.railsScenes = <%= @scenes.map { |scene|
    {
      id: scene.id,
      name: scene.name,
      description: scene.description,
      x: scene.x,
      y: scene.y,
      connections: scene.connections,
      claimed: scene.claimed?,
      claimed_by: scene.user&.display_name,
      slack_thread_url: scene.slack_thread_url,
      path: scene_path(scene),
      completed: @completed_scenes.include?(scene.id)
    }
  }.to_json.html_safe %>;
</script>
<footer style="position: fixed; bottom: 10px; left: 0; right: 0; text-align: center; z-index: 1000;">
  <a href="https://isle.a.hackclub.dev/dash"
     style="background: white; padding: 4px 8px; border-radius: 6px; text-decoration: none; color: black;">
    See Dashboard
  </a>
</footer>
